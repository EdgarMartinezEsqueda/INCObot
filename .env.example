#Token del bot
TOKEN=TOKENDETUBOT
#ID del bot, lo puedes encontrar en el portal de desarrolladores de Discord
CLIENTID=IDDETUBOT
#PREFIJO PARA LOS COMANDOS, EJEMPLO: "!" -> "!play", "!help", etc
PREFIX="PREFIJOPARACOMANDOS"
#APIs Externas (GIF con KLIPY y el clima con Open Weather)
#Clave de app de KLIPY: https://partner.klipy.com (docs: https://docs.klipy.com)
KLIPY_KEY=TUAPPKEYDEKLIPY
APICLIMA=TUAPIKEYDELCLIMA
#DB Config
DBUSERNAME=USUARIO
DBPASS=CONTRADB
DBHOST=IPDB
DB=NOMBREDB
#ID Canales en los que se pueda usar el comando 'play', para evitar spam
IDCANALES=IDCANAL || "IDCANAL1,IDCANAL2,..."

#--- Música (todas opcionales) ---
#Logs detallados de DisTube y de la línea de ffmpeg. Ponlo en 1 si algo no suena.
DISTUBE_DEBUG=0
#Ruta a un ffmpeg propio. Si se omite se usa el de ffmpeg-static y, si ese no
#bajó su binario, el ffmpeg del sistema (apt install ffmpeg).
#FFMPEG_PATH=/usr/bin/ffmpeg
#YouTube bloquea las IPs de centros de datos, así que en un VPS puede pedir
#"Sign in to confirm you're not a bot" o contestar 403 al descargar el audio.
#Estas dos son la salida: exporta las cookies de una sesión de YouTube en
#formato Netscape, o manda las peticiones por un proxy con IP residencial.
#YTDLP_COOKIES=/ruta/a/cookies.txt
#YTDLP_PROXY=http://usuario:clave@host:puerto
#Cliente del reproductor que usa yt-dlp. Sólo tócalo si lo de arriba no basta.
#YTDLP_PLAYER_CLIENT=tv,web_safari